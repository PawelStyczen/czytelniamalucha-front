---
const { showCta = true } = Astro.props;

const navLinks = [
  {
    href: "/globalne-czytanie-dlaczego-warto/",
    label: "Dlaczego warto",
  },
  { href: "/o-nas/", label: "O nas" },

  { href: "/#oferta", label: "Oferta" },
  { href: "/blog", label: "Blog" },
  { href: "/#faq", label: "FAQ" },
];
---

<header class="nav-shell">
  <nav class="nav-desktop" aria-label="Nawigacja główna">
    <div class="nav-desktop__inner">
      <div class="nav-brand-group">
        <a href="/" class="nav-brand" aria-label="Czytelnia Malucha">
          <img
            src="/img/czytelnia-malucha-logo.svg"
            alt="Logo Czytelnia Malucha"
            class="nav-brand__logo"
          />
        </a>

        <div class="nav-socials" aria-label="Media społecznościowe">
          <a
            class="nav-social-link"
            href="https://www.facebook.com/profile.php?id=61592400278330&amp;mibextid=wwXIfr&amp;rdid=wu8n9Mvv3up4k6W9&amp;share_url=https%3A%2F%2Fwww.facebook.com%2Fshare%2F1JxdoXxrVy%2F%3Fmibextid%3DwwXIfr"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Czytelnia Malucha na Facebooku (otwiera w nowej karcie)"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M14 8.5V7c0-.8.5-1 1-1h2V3h-2.7C11.5 3 10 4.7 10 7.3v1.2H7V12h3v9h4v-9h2.7l.5-3.5H14Z"
              ></path>
            </svg>
          </a>
          <a
            class="nav-social-link"
            href="https://www.instagram.com/czytelniamalucha/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Czytelnia Malucha na Instagramie (otwiera w nowej karcie)"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5"></rect>
              <circle cx="12" cy="12" r="4"></circle>
              <circle class="nav-social-link__dot" cx="17.4" cy="6.6" r="1"></circle>
            </svg>
          </a>
        </div>
      </div>

      <div class="nav-desktop__links">
        {
          navLinks.map((link) => (
            <a href={link.href} class="nav-link">
              {link.label}
            </a>
          ))
        }
      </div>

      {
        showCta && (
          <a class="btn btn-primary nav-desktop__cta" href="/#oferta">
            Zestawy
          </a>
        )
      }
    </div>
  </nav>

  <nav class="nav-mobile" aria-label="Nawigacja mobilna">
    <div class="nav-mobile__backdrop" data-open="false"></div>

    <div id="mobileNavMenu" class="nav-mobile__menu" data-open="false">
      <div class="nav-mobile__menu-top">
        <span class="nav-mobile__menu-title">Menu</span>
        <button
          class="nav-mobile__menu-close"
          type="button"
          data-nav-close
          aria-label="Zamknij menu"
        >
          ✕
        </button>
      </div>

      {
        navLinks.map((link) => (
          <a href={link.href} class="nav-mobile__menu-link">
            {link.label}
          </a>
        ))
      }
    </div>

    <div class="nav-mobile__bar">
      <div class="nav-brand-group">
        <a
          href="/"
          class="nav-brand nav-brand--mobile"
          aria-label="Czytelnia Malucha"
        >
          <img
            src="/img/czytelnia-malucha-logo.svg"
            alt="Logo Czytelnia Malucha"
            class="nav-brand__logo nav-brand__logo--mobile"
          />
        </a>

        <div class="nav-socials" aria-label="Media społecznościowe">
          <a
            class="nav-social-link"
            href="https://www.facebook.com/profile.php?id=61592400278330&amp;mibextid=wwXIfr&amp;rdid=wu8n9Mvv3up4k6W9&amp;share_url=https%3A%2F%2Fwww.facebook.com%2Fshare%2F1JxdoXxrVy%2F%3Fmibextid%3DwwXIfr"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Czytelnia Malucha na Facebooku (otwiera w nowej karcie)"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M14 8.5V7c0-.8.5-1 1-1h2V3h-2.7C11.5 3 10 4.7 10 7.3v1.2H7V12h3v9h4v-9h2.7l.5-3.5H14Z"
              ></path>
            </svg>
          </a>
          <a
            class="nav-social-link"
            href="https://www.instagram.com/czytelniamalucha/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Czytelnia Malucha na Instagramie (otwiera w nowej karcie)"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5"></rect>
              <circle cx="12" cy="12" r="4"></circle>
              <circle class="nav-social-link__dot" cx="17.4" cy="6.6" r="1"></circle>
            </svg>
          </a>
        </div>
      </div>

      {
        showCta && (
          <a class="btn btn-primary nav-mobile__cta" href="/#oferta">
            Zestawy
          </a>
        )
      }

      <button
        id="mobileNavToggle"
        class="nav-mobile__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobileNavMenu"
        aria-label="Otwórz menu"
      >
        <span class="nav-mobile__toggle-line"></span>
        <span class="nav-mobile__toggle-line"></span>
        <span class="nav-mobile__toggle-line"></span>
      </button>
    </div>
  </nav>
</header>

<style>
  .nav-shell {
    position: relative;
    z-index: 9999;
  }

  .nav-brand {
    display: flex;
    align-items: center;
    flex: 0 0 auto;
  }

  .nav-brand-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: 0 0 auto;
  }

  .nav-brand__logo {
    display: block;
    width: auto;
    height: 48px;
  }

  .nav-link {
    font-family: var(--font-sans);
    padding: 8px 10px;
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.18s ease;
  }

  .nav-link:hover {
    background: rgba(230, 230, 230, 0.7);
  }

  .nav-desktop {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    padding: 10px 0;
    background: rgba(255, 255, 255, 0.94);
    border-bottom: 1px solid rgba(58, 58, 58, 0.12);
    backdrop-filter: blur(10px);
  }

  .nav-desktop__inner {
    width: min(1100px, calc(100% - 32px));
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(0.5rem, 1vw, 1rem);
  }

  .nav-desktop__links {
    display: flex;
    align-items: center;
    gap: clamp(2px, 1vw, 14px);
    flex-wrap: nowrap;
    margin-left: auto;
  }

  .nav-socials {
    display: flex;
    align-items: center;
    flex: 0 0 auto;
    gap: 0.1rem;
  }

  .nav-desktop__cta {
    white-space: nowrap;
  }

  .nav-social-link {
    display: inline-flex;
    width: 36px;
    height: 36px;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    color: #b38f78;
    transition:
      color 0.18s ease,
      background 0.18s ease;
  }

  .nav-social-link:hover {
    color: #8f6d57;
    background: var(--paper);
  }

  .nav-social-link:focus-visible {
    outline: 2px solid var(--green);
    outline-offset: 2px;
  }

  .nav-social-link svg {
    width: 19px;
    height: 19px;
    fill: currentColor;
  }

  .nav-social-link rect,
  .nav-social-link circle:not(.nav-social-link__dot) {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
  }

  .nav-social-link__dot {
    stroke: none;
  }

  .nav-mobile {
    display: none;
  }

  @media (max-width: 920px) {
    .nav-desktop {
      display: none;
    }

    .nav-mobile {
      display: block;
      position: fixed;
      left: 0;
      right: 0;
      top: 0;
      z-index: 9999;
      pointer-events: none;
    }

    .nav-mobile__bar {
      width: min(400px, calc(100% - 16px));
      margin: 10px auto 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.35rem;
      padding: 10px 12px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.95);
      border: 1px solid rgba(58, 58, 58, 0.12);
      box-shadow: 0 18px 45px rgba(0, 0, 0, 0.12);
      backdrop-filter: blur(12px);
      pointer-events: auto;
    }

    .nav-brand__logo--mobile {
      height: 40px;
    }

    .nav-mobile__bar .nav-social-link {
      width: 36px;
      height: 36px;
    }

    .nav-mobile__cta {
      flex: 0 0 auto;
      white-space: nowrap;
      padding: 0.65rem 0.85rem;
      font-size: 0.9rem;
      text-decoration: none;
    }

    .nav-mobile__toggle {
      width: 46px;
      height: 46px;
      padding: 0;
      border: 1px solid rgba(58, 58, 58, 0.12);
      border-radius: 14px;
      background: rgba(255, 255, 255, 0.86);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      gap: 5px;
      cursor: pointer;
      flex: 0 0 auto;
    }

    .nav-mobile__toggle-line {
      display: block;
      width: 18px;
      height: 2px;
      border-radius: 999px;
      background: var(--graphite);
      transition:
        transform 0.18s ease,
        opacity 0.18s ease;
    }

    .nav-mobile__toggle[aria-expanded="true"]
      .nav-mobile__toggle-line:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }

    .nav-mobile__toggle[aria-expanded="true"]
      .nav-mobile__toggle-line:nth-child(2) {
      opacity: 0;
    }

    .nav-mobile__toggle[aria-expanded="true"]
      .nav-mobile__toggle-line:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }

    .nav-mobile__menu {
      position: fixed;
      top: 0;
      right: 0;
      display: flex;
      width: min(320px, calc(100vw - 48px));
      height: 100dvh;
      flex-direction: column;
      gap: 0.35rem;
      padding: 1rem;
      background: rgba(255, 255, 255, 0.98);
      border-left: 1px solid rgba(58, 58, 58, 0.08);
      box-shadow: -18px 0 45px rgba(0, 0, 0, 0.08);
      backdrop-filter: blur(12px);
      transform: translateX(100%);
      opacity: 0;
      visibility: hidden;
      transition:
        transform 0.24s ease,
        opacity 0.24s ease,
        visibility 0.24s ease;
      pointer-events: auto;
      z-index: 999;
    }

    .nav-mobile__menu[data-open="true"] {
      transform: translateX(0);
      opacity: 1;
      visibility: visible;
    }

    .nav-mobile__backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.28);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition:
        opacity 0.24s ease,
        visibility 0.24s ease;
    }

    .nav-mobile__backdrop[data-open="true"] {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    .nav-mobile__menu-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      margin-bottom: 0.75rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid rgba(58, 58, 58, 0.08);
    }

    .nav-mobile__menu-title {
      font-family: var(--font-sans);
      font-size: 1rem;
      font-weight: 800;
      letter-spacing: 0.02em;
    }

    .nav-mobile__menu-close {
      width: 42px;
      height: 42px;
      padding: 0;
      border: 1px solid rgba(58, 58, 58, 0.12);
      border-radius: 14px;
      background: rgba(255, 255, 255, 0.86);
      cursor: pointer;
    }

    .nav-mobile__menu-link {
      padding: 12px 14px;
      border-radius: 16px;
      background: rgba(244, 239, 234, 0.46);
      font-family: var(--font-sans);
      font-weight: 600;
      text-decoration: none;
    }
  }

  @media (max-width: 640px) {
    .nav-mobile__bar {
      padding: 8px 10px;
      margin-top: 8px;
      gap: 0.25rem;
    }

    .nav-mobile__bar .nav-brand-group {
      gap: 0.2rem;
    }

    .nav-brand__logo--mobile {
      height: 32px;
    }

    .nav-mobile__bar .nav-social-link {
      width: 28px;
      height: 32px;
    }

    .nav-mobile__bar .nav-social-link svg {
      width: 17px;
      height: 17px;
    }

    .nav-mobile__cta {
      padding: 0.55rem 0.65rem;
      font-size: 0.85rem;
    }

    .nav-mobile__toggle {
      width: 40px;
      height: 40px;
    }
  }
</style>

<script is:inline>
  const mobileNavToggle = document.getElementById("mobileNavToggle");
  const mobileNavMenu = document.getElementById("mobileNavMenu");
  const mobileNavBackdrop = document.querySelector(".nav-mobile__backdrop");

  function closeMobileNavMenu() {
    if (!mobileNavToggle || !mobileNavMenu || !mobileNavBackdrop) return;
    mobileNavToggle.setAttribute("aria-expanded", "false");
    mobileNavMenu.setAttribute("data-open", "false");
    mobileNavBackdrop.setAttribute("data-open", "false");
    document.body.style.overflow = "";
  }

  function toggleMobileNavMenu() {
    if (!mobileNavToggle || !mobileNavMenu || !mobileNavBackdrop) return;
    const isOpen = mobileNavToggle.getAttribute("aria-expanded") === "true";
    mobileNavToggle.setAttribute("aria-expanded", String(!isOpen));
    mobileNavMenu.setAttribute("data-open", String(!isOpen));
    mobileNavBackdrop.setAttribute("data-open", String(!isOpen));
    document.body.style.overflow = isOpen ? "" : "hidden";
  }

  mobileNavToggle?.addEventListener("click", () => {
    toggleMobileNavMenu();
  });

  document.addEventListener("click", (event) => {
    if (!mobileNavToggle || !mobileNavMenu || !mobileNavBackdrop) return;
    const target = event.target;
    if (!(target instanceof Node)) return;

    const clickedInsideMenu = mobileNavMenu.contains(target);
    const clickedToggle = mobileNavToggle.contains(target);
    const clickedBackdrop =
      target instanceof Element && target.closest(".nav-mobile__backdrop");
    const clickedClose =
      target instanceof Element && target.closest("[data-nav-close]");

    if (clickedBackdrop || clickedClose) {
      closeMobileNavMenu();
      return;
    }

    if (!clickedInsideMenu && !clickedToggle) {
      closeMobileNavMenu();
    }

    if (target instanceof Element && target.closest(".nav-mobile__menu-link")) {
      closeMobileNavMenu();
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeMobileNavMenu();
    }
  });

  window.addEventListener("resize", () => {
    if (window.innerWidth > 920) {
      closeMobileNavMenu();
    }
  });
</script>
