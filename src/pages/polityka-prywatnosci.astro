---
import BaseLayout from "../layouts/BaseLayout.astro";
import LegalPageLayout from "../components/LegalPageLayout.astro";
import {
  formatLegalEffectiveDate,
  getCurrentPrivacyPolicy,
} from "../services/legalDocumentService";

const privacyPolicy = await getCurrentPrivacyPolicy();
const effectiveDate = formatLegalEffectiveDate(privacyPolicy.effectiveFrom);
---

<BaseLayout
  title={`${privacyPolicy.title} - Czytelnia Malucha`}
  description={privacyPolicy.description}
>
  <LegalPageLayout
    title={privacyPolicy.title}
    description={privacyPolicy.description}
    currentLabel="Polityka prywatności"
  >
    <p><strong>Data obowiązywania:</strong> {effectiveDate}</p>
    <p class="document-download">
      <a href={privacyPolicy.pdfUrl} target="_blank" rel="noopener">
        Pobierz politykę prywatności w formacie PDF
      </a>
    </p>
    <div set:html={privacyPolicy.contentHtml} />
  </LegalPageLayout>
</BaseLayout>

<style>
  .document-download {
    margin-bottom: 1.5rem;
  }

  .document-download a {
    display: inline-flex;
    padding: 0.65rem 1rem;
    border: 1px solid rgba(107, 143, 113, 0.45);
    border-radius: 999px;
    color: #4f7457;
    font-weight: 700;
    text-decoration: none;
  }

  .document-download a:hover {
    background: rgba(107, 143, 113, 0.08);
  }
</style>
