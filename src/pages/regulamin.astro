---
import BaseLayout from "../layouts/BaseLayout.astro";
import LegalPageLayout from "../components/LegalPageLayout.astro";
import { getCurrentTerms } from "../services/legalDocumentService";

const terms = await getCurrentTerms();
---

<BaseLayout
  title={`${terms.title} - Czytelnia Malucha`}
  description={terms.description}
>
  <LegalPageLayout
    title={terms.title}
    description={terms.description}
    currentLabel="Regulamin"
  >
    <p class="document-download">
      <a href={terms.pdfUrl} target="_blank" rel="noopener">
        Pobierz regulamin w formacie PDF
      </a>
    </p>
    <div set:html={terms.contentHtml} />
  </LegalPageLayout>
</BaseLayout>

<style>
  .document-download {
    margin-bottom: 1.5rem;
  }

  .document-download a {
    display: inline-flex;
    padding: 0.65rem 1rem;
    border: 1px solid rgba(107, 143, 113, 0.45);
    border-radius: 999px;
    color: #4f7457;
    font-weight: 700;
    text-decoration: none;
  }

  .document-download a:hover {
    background: rgba(107, 143, 113, 0.08);
  }
</style>
